{
  "name": "explorer-plus",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "build:views": "esbuild view-src/notes-md-editor.js --bundle --format=esm --minify --legal-comments=eof \"--banner:js=// 自動で作るファイル。直すときは view-src/notes-md-editor.js を直して npm run build:views\" --outfile=views/builtin.notes/md-editor.js",
    "build:docs": "node scripts/build-mod-docs.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@tauri-apps/cli": "^2",
    "esbuild": "^0.28.2",
    "marked": "^18.1.1",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.4"
  }
