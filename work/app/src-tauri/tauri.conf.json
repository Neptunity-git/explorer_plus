{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "explorer_plus",
  "version": "0.5.0",
  "identifier": "com.neoneptunity.explorerplus",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "explorer_plus",
        "width": 1100,
        "height": 640,
        "minWidth": 640,
        "minHeight": 400,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' http://icon.localhost data:; frame-src http://mod.localhost; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../views/": "views/",
      "../runtime/": "runtime/",
      "../mod-template/": "mod-template/",
      "../mod-docs/": "mod-docs/"
    }
  }
}
